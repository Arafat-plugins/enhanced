{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "960px", "wideSize": "1380px" },
		"color": {
			"defaultPalette": false,
			"custom": true,
			"palette": [
				{ "slug": "ink",     "color": "#1a1a1a", "name": "Ink" },
				{ "slug": "accent",  "color": "#e53e3e", "name": "Accent" },
				{ "slug": "bg",      "color": "#f5f5f5", "name": "Background" },
				{ "slug": "white",   "color": "#ffffff", "name": "White" },
				{ "slug": "muted",   "color": "#888888", "name": "Muted" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{ "slug": "display", "name": "Display", "fontFamily": "\"DM Serif Display\", \"Playfair Display\", Georgia, serif" },
				{ "slug": "ui",      "name": "UI",      "fontFamily": "\"Inter\", \"Helvetica Neue\", Arial, sans-serif" }
			],
			"fontSizes": [
				{ "slug": "sm",  "size": "12px", "name": "Small" },
				{ "slug": "md",  "size": "15px", "name": "Medium" },
				{ "slug": "lg",  "size": "20px", "name": "Large" },
				{ "slug": "xl",  "size": "28px", "name": "XL" },
				{ "slug": "2xl", "size": "clamp(32px,4vw,52px)", "name": "2XL" }
			]
		}
	},
	"styles": {
		"color":      { "background": "#f5f5f5", "text": "#1a1a1a" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--ui)", "lineHeight": "1.6" },
		"elements": {
			"h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)" } },
			"h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)" } },
			"h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)" } }
		}
	}
}
